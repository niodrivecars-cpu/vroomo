# Vroom environment variables.
# Copy this file to `.env` and adjust values for local development:
#   copy .env.example .env   (Windows)   /   cp .env.example .env   (Linux/macOS)

# Security: generate with  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-to-a-secure-random-value

# Debug mode. NEVER set True in production.
DEBUG=True

# Comma-separated list of host/domain names this server can serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed origins for CSRF (usually only production).
# Example: https://vroom.example.com
CSRF_TRUSTED_ORIGINS=

# ---- Database ---------------------------------------------------------------
# Preferred: a full connection URL. Use this whenever the password contains
# special characters (@ : / #), which break URL-style DB_* settings.
# DATABASE_URL=postgres://vroom:vroom@localhost:5432/vroom
# Fallback: individual fields (used when DATABASE_URL is empty).
DB_NAME=vroom
DB_USER=vroom
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# ---- Cache ------------------------------------------------------------------
# Redis URL. Leave empty to use Django's in-memory LocMemCache (dev only).
# CACHE_URL=redis://localhost:6379/0

# ---- Email (Gmail SMTP with an app password) --------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_TIMEOUT=30
# From/error addresses (defaults to "Vroom <EMAIL_HOST_USER>").
# DEFAULT_FROM_EMAIL=Vroom <your-email@gmail.com>
# SERVER_EMAIL=Vroom Server <your-email@gmail.com>

# Admin address used for notifications.
ADMIN_EMAIL=admin@vroom.local

# ---- Localization & timezone ------------------------------------------------
LANGUAGE_CODE=en
TIME_ZONE=Africa/Casablanca

# ---- Static & media ---------------------------------------------------------
# STATIC_ROOT=C:\path\to\staticfiles
# MEDIA_ROOT=C:\path\to\media

# ---- Logging ----------------------------------------------------------------
# LOG_LEVEL=INFO
# File logging: set an absolute directory to also write a rotating vroom.log.
# LOG_DIR=C:\logs\vroom

# ---- Cookies ----------------------------------------------------------------
# SESSION_COOKIE_SECURE=True

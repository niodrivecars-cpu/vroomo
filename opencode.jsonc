{
  // Vroomo (Django fleet management) project-level opencode config.
  // Requires opencode restart to take effect.
  "$schema": "https://opencode.ai/config.json",

  // Sub-agents live as files under .opencode/agent/. Inline references here
  // only pin non-config defaults if ever needed.

  "mcp": {
    "postgres": {
      // Legacy: Postgres MCP (crystaldba). The production and dev database is
      // now MySQL 8 (ADR 0006, 2026-08-07); the postgres:16 Docker service was
      // replaced by mysql:8.0, so this server has nothing to connect to.
      // Kept disabled until a MySQL inspection MCP is configured.
      "type": "local",
      "command": ["uvx", "postgres-mcp", "--access-mode=unrestricted"],
      "enabled": false,
      "environment": {
        "DATABASE_URI": "postgresql://vroomo:vroomo@localhost:5432/vroomo"
      }
    },
    "playwright": {
      // Browser automation for E2E testing of the RTL Bootstrap UI.
      // `npx`/`node` are already present on this machine.
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "environment": {
        "BROWSER": "chromium"
      }
    }
  }
}

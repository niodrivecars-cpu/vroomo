# Vroom PRODUCTION environment template.
# Copy to the server and fill in real values, then set the file readable only
# by the deploy user (chmod 600). This file must never be committed.
#
# Generate secrets:  python -c "import secrets; print(secrets.token_urlsafe(64))"

# REQUIRED. Long random value, unique per environment.
SECRET_KEY=replace-with-a-long-random-secret

# MUST be False in production (the config will refuse to start otherwise).
DEBUG=False

# REQUIRED. Comma-separated public hostnames, e.g. vroom.example.com,vroom.example.org
ALLOWED_HOSTS=replace-me.example.com

# REQUIRED for HTTPS forms. Comma-separated full origins (scheme + host):
CSRF_TRUSTED_ORIGINS=https://replace-me.example.com

# ---- Database ---------------------------------------------------------------
# Preferred: full URL. MySQL/MariaDB (Hostinger) is the production reference;
# PostgreSQL also works (backup.sh/restore.sh handle both schemes).
DATABASE_URL=mysql://vroom:REPLACE_ME@127.0.0.1:3306/vroom
# Fallback (only used if DATABASE_URL is empty):
# DB_NAME=vroom
# DB_USER=vroom
# DB_PASSWORD=REPLACE_ME
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ---- Cache (Redis) ----------------------------------------------------------
# Recommended when a Redis host is available (VPS). Empty falls back to
# in-memory cache — the default on Hostinger shared hosting (no Redis).
CACHE_URL=

# ---- Email (Gmail SMTP with an app password) --------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=REPLACE_ME
EMAIL_HOST_PASSWORD=REPLACE_ME
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=Vroom <REPLACE_ME>
SERVER_EMAIL=Vroom Server <REPLACE_ME>
ADMIN_EMAIL=REPLACE_ME

# ---- Reverse proxy (REQUIRED for correct client IPs) ------------------------
# Comma-separated IPs of the reverse proxy in front of the app. The app only
# trusts X-Forwarded-For from these peers; all other forwarding headers are
# ignored.
#   VPS (nginx + gunicorn on 127.0.0.1): TRUSTED_PROXY_IPS=127.0.0.1
#   Hostinger shared (LiteSpeed/Apache -> Passenger): set to the proxy
#   addresses if Hostinger exposes them; an empty value falls back to
#   REMOTE_ADDR (safe default — no spoofable forwarded IPs are trusted).
TRUSTED_PROXY_IPS=

# ---- Localization & timezone ------------------------------------------------
LANGUAGE_CODE=en
TIME_ZONE=Africa/Casablanca

# ---- Static & media ---------------------------------------------------------
# Optional: override only if the deploy layout differs from the default.
# STATIC_ROOT=/opt/vroom/staticfiles
# MEDIA_ROOT=/opt/vroom/media

# ---- Logging ----------------------------------------------------------------
# LOG_LEVEL=INFO
# Absolute directory for the rotating vroom.log file (console output always on).
# LOG_DIR=/var/log/vroom

# ---- Document downloads -----------------------------------------------------
# Signed download link TTL in seconds (default 86400)
DOCUMENT_SIGNED_URL_TTL=86400
# Download rate limits (format: N/(s|m|h|d))
DOWNLOAD_RATE_LIMIT=20/h
DOWNLOAD_ANON_RATE_LIMIT=10/h
